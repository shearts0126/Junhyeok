// DEEPPOINT SCM OS — Prisma Schema
//
// T0-2 시점에는 업무 모델을 정의하지 않는다.
// 연결 구성과 마이그레이션 체계만 세우고, 모델은 후속 작업에서 추가한다.
//   - User / Role / Permission     : T0-6
//   - SystemSetting / AuditLog     : T0-7
//   - CommonCode                   : T0-8
//   - Sku / SkuBarcode / ...       : R1a-1
//   - InventoryTransaction / ...   : R1a-2
//
// 설계 문서: docs/03_ERD와_Prisma스키마_v0.2.md
//
// ⚠️ Prisma 7 변경사항
//   datasource 의 url / directUrl 은 더 이상 스키마에 둘 수 없다.
//   - 마이그레이션용 연결       → prisma.config.ts (DIRECT_URL)
//   - 애플리케이션 런타임 연결  → PrismaClient 의 driver adapter (DATABASE_URL)
//   자세한 내용은 README "데이터베이스" 절 참조.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // 수량·금액은 DECIMAL 을 사용하며 Prisma.Decimal(decimal.js) 로 반환된다.
  // Number() 변환은 정밀도 손실을 일으키므로 금지한다 (BOM 소요량 1/30 등).
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// 인증·권한 (T0-6)
//
// 설계 문서 docs/03_ERD와_Prisma스키마_v0.2.md §인증·권한
//
// ⚠️ Supabase 가 관리하는 `auth.users` 테이블을 모델링하거나 relation 으로
//    연결하지 않는다. 그 테이블은 Supabase 의 소유이고 스키마가 바뀔 수 있다.
//    로컬 `user` 는 인증 사용자의 **미러**이자 SCM 권한 상태의 기준이며,
//    `id` 만 `auth.users.id` 와 같은 UUID 를 공유한다.
// ═══════════════════════════════════════════════════════════════

/// SCM 시스템 사용자. Supabase 인증 사용자의 미러.
/// 인증 성공만으로 자동 생성되지 않는다 — 승인된 사용자만 이 표에 들어온다.
model User {
  /// Supabase auth.users.id 와 동일한 UUID. 자동 생성하지 않는다.
  id        String     @id @db.Uuid
  email     String     @unique
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  userRoles UserRole[]

  auditLogs       AuditLog[]      @relation("AuditActor")
  approvedAudits  AuditLog[]      @relation("AuditApprover")
  updatedSettings SystemSetting[] @relation("SettingUpdatedBy")

  createdCodeGroups CommonCodeGroup[] @relation("CodeGroupCreatedBy")
  updatedCodeGroups CommonCodeGroup[] @relation("CodeGroupUpdatedBy")
  createdCodes      CommonCode[]      @relation("CodeCreatedBy")
  updatedCodes      CommonCode[]      @relation("CodeUpdatedBy")

  createdSkus  Sku[] @relation("SkuCreatedBy")
  updatedSkus  Sku[] @relation("SkuUpdatedBy")
  approvedSkus Sku[] @relation("SkuApprovedBy")

  approvedSkuBarcodes SkuBarcode[] @relation("SkuBarcodeApprovedBy")

  idempotencyRecords IdempotencyRecord[] @relation("IdempotencyActor")

  /// 가격이력 actor (T06-1). Prisma compile 에 필요한 최소 inverse 다 —
  /// 새 business semantics 를 부여하지 않는다.
  createdSupplierSkuPrices  SupplierSkuPrice[] @relation("SupplierSkuPriceCreatedBy")
  approvedSupplierSkuPrices SupplierSkuPrice[] @relation("SupplierSkuPriceApprovedBy")

  createdBomHeaders  BomHeader[] @relation("BomHeaderCreatedBy")
  approvedBomHeaders BomHeader[] @relation("BomHeaderApprovedBy")

  @@map("user")
}

/// 역할. ADMIN / SCM_LEADER / SCM_STAFF / FINANCE / EXECUTIVE
model Role {
  id       String @id @default(uuid()) @db.Uuid
  roleCode String @unique @map("role_code")
  roleName String @map("role_name")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

/// 권한. "role.read", "sku.approve" 같은 점 표기 키.
model Permission {
  id            String  @id @default(uuid()) @db.Uuid
  permissionKey String  @unique @map("permission_key")
  description   String?

  rolePermissions RolePermission[]

  @@map("permission")
}

/// 역할 ↔ 권한. ADMIN 도 여기에 행이 있어야 권한을 갖는다(코드상 예외 없음).
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

/// 사용자 ↔ 역할.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz
  /// 부여한 사용자. 시스템 시드는 NULL.
  grantedBy String?  @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ═══════════════════════════════════════════════════════════════
// 시스템 설정·감사로그 (T0-7)
// ═══════════════════════════════════════════════════════════════

/// 운영 중 바뀌는 값. 코드에 하드코딩하지 않는다.
///
/// ⚠️ **타입이 명시된 단일 설정 행**이다(singleton, `id = 1`).
///    자유 형식 JSON EAV 를 쓰지 않는다 — 설정 하나하나가 업무 판정에 직접
///    쓰이므로 valueType 분기·NULL 조합·알 수 없는 키가 끼어들 여지를 두지 않는다.
///
/// ⛔ 일반 `allow_self_approval` 컬럼은 만들지 않는다.
///    재고조정 승인·음수재고 예외 승인·월마감 해제는 설정과 무관하게
///    항상 요청자≠승인자다 (ADMIN 예외 없음).
model SystemSetting {
  /// singleton. 항상 1.
  id                   Int       @id
  allowSelfApprovalSku Boolean   @default(false) @map("allow_self_approval_sku")
  allowSelfApprovalBom Boolean   @default(false) @map("allow_self_approval_bom")
  /// 전환 기준일 (D-01). UAT 완료 후 관리자가 설정한다.
  cutoverDate          DateTime? @map("cutover_date") @db.Date
  /// balance 재구축 중 Posting 차단
  postingFrozen        Boolean   @default(false) @map("posting_frozen")
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy            String?   @map("updated_by") @db.Uuid
  /// 낙관적 동시성 제어. 변경마다 증가한다.
  version              Int       @default(1)

  /// 사용자를 지워도 설정 이력이 훼손되지 않도록 SET NULL.
  updatedByUser User? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("system_setting")
}

/// 감사로그. **불변**이다.
///
/// UPDATE / DELETE / TRUNCATE 는 DB 트리거로 차단한다.
/// 애플리케이션 코드만으로 불변성을 보장하지 않는다 — 직접 SQL 실행도 막아야 한다.
///
/// ⛔ `updated_at` 컬럼이 없다. 수정 API·삭제 API 도 없다.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  /// 수행자. ActorContext 에서만 취득한다.
  actorId     String   @map("actor_id") @db.Uuid
  /// 승인자. 승인 행위가 아닌 경우 NULL.
  approvedBy  String?  @map("approved_by") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  reason      String?
  requestId   String?  @map("request_id")
  sessionId   String?  @map("session_id")
  ipAddress   String?  @map("ip_address")

  /// 사용자를 지워도 감사로그가 사라지면 안 된다.
  actor    User  @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  approver User? @relation("AuditApprover", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

// ═══════════════════════════════════════════════════════════════
// 공통코드 (T0-8)
//
// 5개 엑셀에 흩어져 있던 코드사전(브랜드·대분류·소분류·부자재분류·보관처·채널)의
// 단일 기준. 설계 문서 docs/03_ERD와_Prisma스키마_v0.2.md §공통코드.
//
// ⛔ 물리삭제하지 않는다. "삭제" 는 항상 active=false (비활성화)다.
//    코드를 지우면 그 코드를 참조하던 과거 기록의 의미가 사라진다.
//    향후 SKU·Warehouse 등이 공통코드를 참조할 때는 FK ON DELETE RESTRICT 를 쓴다.
// ═══════════════════════════════════════════════════════════════

/// 코드 그룹. BRAND / MAJOR_CATEGORY / MINOR_CATEGORY / MATERIAL_CATEGORY /
/// STORAGE_LOCATION / CHANNEL (T0-8 seed 6종).
///
/// 그룹은 seed·migration 관리 대상이다. 생성·수정 API 가 없고
/// `group_code` 는 API 로 변경하지 않는다.
model CommonCodeGroup {
  id          String  @id @default(uuid()) @db.Uuid
  /// 안정 키. 빈 문자열·앞뒤 공백 금지 (DB CHECK).
  groupCode   String  @unique @map("group_code")
  groupName   String  @map("group_name")
  description String?

  /// 그룹 간 계층 (예: 소분류 → 대분류). 원본 코드사전에 계층이 있을 때만 설정한다.
  /// ⚠️ T0-8 seed 6종은 전부 NULL — 원본 사전에 그룹 간 계층이 없음을 데이터로
  ///    확인했다 (소분류 8종이 여러 대분류 아래에서 사용됨).
  parentGroupId String? @map("parent_group_id") @db.Uuid

  /// 0 이상 (DB CHECK).
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// seed 는 NULL. API 생성 경로가 없으므로 현재는 항상 NULL 이다.
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid

  /// 부모 그룹을 참조하는 그룹이 있으면 부모를 지울 수 없다.
  parentGroup CommonCodeGroup?  @relation("CodeGroupHierarchy", fields: [parentGroupId], references: [id], onDelete: Restrict)
  childGroups CommonCodeGroup[] @relation("CodeGroupHierarchy")
  codes       CommonCode[]

  createdByUser User? @relation("CodeGroupCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("CodeGroupUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("common_code_group")
}

/// 코드 값.
///
/// - `code` 와 `group_id` 는 생성 후 변경 불가 (Application Service 가 강제)
/// - 수정 가능: name · parentCode · sortOrder · attributes · active
/// - ⛔ 물리삭제 API·repository delete 메서드가 없다
model CommonCode {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @map("group_id") @db.Uuid
  /// 그룹 내 UNIQUE. 빈 문자열·앞뒤 공백 금지 (DB CHECK). 생성 후 변경 불가.
  code    String
  /// 빈 문자열·앞뒤 공백 금지 (DB CHECK). 내부 공백은 허용한다.
  name    String

  /// 다른 그룹의 코드를 부모로 가질 수 있다 (예: 소분류 → 대분류 코드).
  /// 같은 그룹 강제 DB 제약을 두지 않는 대신 Application Service 가
  /// "그룹의 parent_group 과 부모 코드의 group 일치"를 검증한다.
  parentCodeId String? @map("parent_code_id") @db.Uuid

  /// 0 이상 (DB CHECK).
  sortOrder Int @default(0) @map("sort_order")

  /// 원본 사전의 부가 정보 (영문명·순번 표기·판매처·출고유형 등). 자유 형식.
  attributes Json?
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// seed 는 NULL, API 생성은 ActorContext 의 사용자.
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid

  /// 코드가 있는 그룹은 지울 수 없다.
  group      CommonCodeGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  /// 자식이 참조하는 부모 코드는 지울 수 없다.
  parentCode CommonCode?     @relation("CommonCodeHierarchy", fields: [parentCodeId], references: [id], onDelete: Restrict)
  childCodes CommonCode[]    @relation("CommonCodeHierarchy")

  createdByUser User? @relation("CodeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("CodeUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  /// SKU 가 참조하는 코드 (브랜드·대분류·소분류). RESTRICT — 참조 중 물리삭제 불가.
  brandSkus         Sku[] @relation("SkuBrand")
  majorCategorySkus Sku[] @relation("SkuMajorCategory")
  minorCategorySkus Sku[] @relation("SkuMinorCategory")

  @@unique([groupId, code])
  @@index([groupId, active, sortOrder])
  @@index([parentCodeId])
  @@map("common_code")
}

// ═══════════════════════════════════════════════════════════════
// SKU 마스터 (T1-1)
//
// 설계 문서 docs/03_ERD와_Prisma스키마_v0.2.md §Layer 1.
//
// T1-1 은 **스키마와 migration 만** 다룬다. CRUD API·상태전이·승인 워크플로·
// 화면은 T1-2 이후다.
//
// ⛔ `negativeStockAllowed` 가 없다 — **폐기된 설계**다 (PENDING_v0.3 §1 확정).
//    SKU 에 상시 음수재고 허용 설정을 두지 않는다. 음수재고는 각 재고 거래별로
//    승인된 예외 요청을 검증한 경우에만 허용한다 (R1a-2 예외요청 모델).
//
// ⛔ 현재고 숫자 필드(stock·quantity·onHandQty …)가 없다. 현재고는
//    InventoryLedgerEntry/InventoryBalance 소관이다. Sku 는 마스터다.
//
// ⛔ 물리삭제하지 않는다. 수명은 상태(INACTIVE/DISCONTINUED/ARCHIVED)로 다루며,
//    `deleted_at` 이 있어도 `sku_code` 는 **생애 전체 전역 UNIQUE** 다 —
//    조건부 UNIQUE 로 완화하지 않는다 (C-06).
// ═══════════════════════════════════════════════════════════════

/// SKU 수명주기 상태. 전이 규칙은 T1-2 의 Application 계층에서 구현한다.
enum SkuStatus {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  ACTIVE
  INACTIVE
  DISCONTINUED
  ARCHIVED
}

/// 품목 마스터.
model Sku {
  id String @id @default(uuid()) @db.Uuid

  /// 전역 UNIQUE (C-06). 빈 문자열·앞뒤 공백 금지 (DB CHECK).
  /// 코드 패턴 위반은 DB 가 아니라 후속 validation/import 의 WARNING 이다 —
  /// 원본에 코드체계 예외 SKU 가 실존하므로 패턴 CHECK 를 걸지 않는다.
  skuCode   String    @unique @map("sku_code") @db.VarChar(80)
  skuName   String    @map("sku_name") @db.VarChar(255)
  skuNameEn String?   @map("sku_name_en") @db.VarChar(255)
  /// T0-8 코드사전에 ITEM_TYPE 그룹이 없으므로 문자열로 유지한다.
  /// 공통코드화는 별도 설계 변경으로 처리한다 — T1-1 에서 seed 를 늘리지 않는다.
  itemType  String    @map("item_type") @db.VarChar(40)
  status    SkuStatus @default(DRAFT)

  /// 공통코드 참조 (T0-8 정책: FK + ON DELETE RESTRICT).
  /// ⚠️ group 일치(brandId 가 BRAND 그룹의 코드인지)는 DB FK 로 강제되지 않는다 —
  ///    후속 SKU application validation 에서 검증한다 (T1-1 limitation).
  brandId         String? @map("brand_id") @db.Uuid
  majorCategoryId String? @map("major_category_id") @db.Uuid
  minorCategoryId String? @map("minor_category_id") @db.Uuid

  /// 앞자리 0 보존 — 문자열이다.
  serialNumber   String? @map("serial_number") @db.VarChar(20)
  additionalCode String? @map("additional_code") @db.VarChar(30)

  baseUom           String  @default("EA") @map("base_uom") @db.VarChar(20)
  purchaseUom       String? @map("purchase_uom") @db.VarChar(20)
  unitConversionQty Decimal @default(1) @map("unit_conversion_qty") @db.Decimal(18, 6)

  inventoryManaged Boolean @default(true) @map("inventory_managed")
  sellable         Boolean @default(false)
  purchasable      Boolean @default(false)
  manufacturable   Boolean @default(false)

  /// ✏️ D-03 — 오픈 시 전 SKU 미관리로 시작해 순차 전환한다. 기본값 true 금지.
  lotManaged    Boolean @default(false) @map("lot_managed")
  expiryManaged Boolean @default(false) @map("expiry_managed")
  serialManaged Boolean @default(false) @map("serial_managed")

  defaultShelfLifeDays       Int?    @map("default_shelf_life_days")
  minimumRemainingDays       Int?    @map("minimum_remaining_days")
  reconciliationToleranceQty Decimal @default(0) @map("reconciliation_tolerance_qty") @db.Decimal(18, 6)

  /// 원본 ERP 값 보존 (G-07). 의미 변환하지 않는다.
  erpItemType         String?   @map("erp_item_type") @db.VarChar(10)
  /// T1-1 에서는 컬럼만 둔다. 값 변경 시점·규칙은 재고 구현 단계에서 확정한다.
  hasTransaction      Boolean   @default(false) @map("has_transaction")
  discontinuationDate DateTime? @map("discontinuation_date") @db.Date
  note                String?

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy  String?   @map("updated_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz
  approvedBy String?   @map("approved_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  /// SKU 가 참조 중인 공통코드는 물리삭제할 수 없다 (T0-8 RESTRICT 정책의 첫 적용).
  brand         CommonCode? @relation("SkuBrand", fields: [brandId], references: [id], onDelete: Restrict)
  majorCategory CommonCode? @relation("SkuMajorCategory", fields: [majorCategoryId], references: [id], onDelete: Restrict)
  minorCategory CommonCode? @relation("SkuMinorCategory", fields: [minorCategoryId], references: [id], onDelete: Restrict)

  /// 마스터는 사용자 삭제에 딸려 지워지면 안 된다 — SET NULL.
  /// (AuditLog.actor_id 의 RESTRICT 는 감사증적용 별도 정책이다)
  createdByUser  User? @relation("SkuCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser  User? @relation("SkuUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  approvedByUser User? @relation("SkuApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  /// SKU 별 다중 바코드 (T04-1).
  barcodes SkuBarcode[]

  /// 외부시스템 상품 매핑 (T05-1). `SkuExternalMapping.sku` 의 필수 inverse relation 이다 —
  /// 신규 업무 컬럼이 아니다.
  externalMappings SkuExternalMapping[]

  /// 공급업체별 공급조건 (T06-1). `SupplierSku.sku` 의 필수 inverse relation 이다 —
  /// 신규 업무 컬럼이 아니다.
  supplierSkus SupplierSku[]

  /// BOM (T07-1). 두 relation 은 `BomHeader.parentSku` · `BomLine.componentSku`
  /// 의 필수 inverse 이며 신규 업무 컬럼이 아니다.
  ///   - `bomHeaders` : 이 SKU 를 **상위**로 갖는 BOM 버전들
  ///   - `bomLines`   : 이 SKU 가 **구성품**으로 쓰인 라인들 (역전개/where-used)
  /// ⛔ `hasBomUsage` provider 는 T07-3 이다 — 여기서 파생 필드를 만들지 않는다.
  bomHeaders BomHeader[] @relation("BomParent")
  bomLines   BomLine[]   @relation("BomComponent")

  @@index([status])
  @@index([itemType])
  @@index([brandId, majorCategoryId, minorCategoryId])
  @@map("sku")
}

// ═══════════════════════════════════════════════════════════════
// SKU 바코드 (T04-1)
//
// 설계 문서 docs/03_ERD와_Prisma스키마.md §Layer 1 (SKU_BARCODE) 및
// §고유조건·인덱스 (Layer 1·2) 의 `sku_barcode` 행.
//
// T04-1 은 **스키마·migration·DB 제약만** 다룬다.
//   - T04-2 바코드 정규화 (지수표기 판정·공백/하이픈 제거·`-` NULL 처리)
//   - T04-3 Barcode CRUD API
//   - T04-4 중복 예외 승인 API/UI
// 는 아직 없다. 이 단계에서 만들어지는 것은 **테이블과 제약뿐**이다.
//
// ⛔ `deletedAt` 이 없다 — 삭제 대신 `status = 'INACTIVE'` 로 비활성화한다.
//    물리삭제 금지는 T04-3 Application/API 에서 강제한다.
// ⛔ 적용기간 overlap 제약·`effective_from <= effective_to` CHECK 를 두지 않는다 —
//    authoritative 문서에 해당 요구가 없다. CRUD 단계에서 정책 확인 후 결정한다.
// ⛔ `status IN ('ACTIVE','INACTIVE')` allowlist CHECK 를 두지 않는다 —
//    본 프로젝트에는 String 컬럼에 열거값 CHECK 를 거는 convention 이 없다
//    (`sku.item_type` 도 VARCHAR + not-blank CHECK 만 있다). limitation 으로 보고한다.
// ═══════════════════════════════════════════════════════════════

/// 바코드의 **포장/용도 구분**이다. 바코드 문자열 포맷(EAN13·UPC·QR …)이 아니다.
/// 문자열 포맷 판정 타입을 여기에 추가하지 않는다.
enum BarcodeType {
  UNIT
  INNER_BOX
  OUTER_BOX
  CHANNEL
  LEGACY
}

/// SKU 별 다중 바코드.
///
/// 조건부 UNIQUE 2종은 Prisma 스키마 언어로 표현할 수 없어 migration 의
/// **raw SQL** 로 추가한다 (서로 다른 규칙이며 하나의 composite unique 로 합치지 않는다):
///   - `ux_barcode_active`  : `UNIQUE(barcode)  WHERE status='ACTIVE' AND duplicate_exception = false`
///     → 바코드 **값 자체**의 전역 활성 중복 차단
///   - `ux_barcode_primary` : `UNIQUE(sku_id)   WHERE is_primary = true AND status='ACTIVE'`
///     → **한 SKU 안**의 활성 대표 바코드 1개 강제
model SkuBarcode {
  id    String @id @default(uuid()) @db.Uuid
  skuId String @map("sku_id") @db.Uuid

  /// ★ 반드시 문자열이다. Int/BigInt/Decimal/Float 금지 —
  ///   앞자리 0 보존과 지수표기 오손 방지가 목적이다 (§00 L-07).
  ///   T04-1 은 값을 변환하지 않는다. 정규화 판정은 T04-2 다.
  barcode     String      @db.VarChar(100)
  barcodeType BarcodeType @default(UNIT) @map("barcode_type")
  isPrimary   Boolean     @default(false) @map("is_primary")

  countryCode String? @map("country_code") @db.VarChar(10)
  channelCode String? @map("channel_code") @db.VarChar(30)

  /// 업무값은 현재 `ACTIVE` / `INACTIVE` 다. 상태전이 규칙(state machine)은
  /// T04-3 이후 Application 계층에서 정의한다 — T04-1 에서 발명하지 않는다.
  status String @default("ACTIVE") @db.VarChar(20)

  /// 중복 예외 여부. **T04-1 에서는 필드와 DB 조건만 존재한다.**
  /// 누가·어떻게 true 로 만들 수 있는지(예외 승인)는 T04-4 범위다.
  duplicateException Boolean @default(false) @map("duplicate_exception")
  exceptionReason    String? @map("exception_reason")
  /// 예외 승인자. T04-4 전에는 Application 이 이 값을 쓰지 않는다.
  approvedBy         String? @map("approved_by") @db.Uuid

  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// SKU 는 물리삭제 대상이 아니다 (상태·soft delete 로 다룬다).
  /// 바코드가 딸려 물리삭제되면 안 되므로 **RESTRICT** 다 — CASCADE 금지.
  sku Sku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  /// 승인 actor FK 는 마스터 테이블의 기존 정책(`sku.approved_by`)과 동일하게
  /// SET NULL 이다 — 사용자를 지워도 마스터 행이 사라지면 안 된다.
  /// (`audit_log.approved_by` 의 RESTRICT 는 감사증적 전용 별도 정책이다.)
  approvedByUser User? @relation("SkuBarcodeApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([skuId])
  @@index([barcode])
  @@map("sku_barcode")
}

// ═══════════════════════════════════════════════════════════════
// 외부시스템 · SKU 외부 상품 매핑 (T05-1)
//
// 근거: docs/12_설계복구_외부상품매핑스키마.md
//       (2026-08-10 External Mapping Schema Design Recovery Decision)
//       원 설계는 docs/03_ERD와_Prisma스키마.md §Layer 1(EXTERNAL_SYSTEM ·
//       SKU_EXTERNAL_MAPPING) 및 §고유조건·인덱스의 `sku_external_mapping` 행.
//
// T05-1 은 **스키마·migration·DB 제약까지만** 다룬다.
//   - T05-2 매핑 CRUD API (코드 없이 상품명만 → REVIEW_REQUIRED 강제)
//   - T05-3 SKU 해석 서비스 (코드 → 바코드 → 승인된 상품명 → 미매칭)
//   - T05-4 매핑 화면 · 미매칭 목록
// 은 아직 없다. 이 단계에서 만들어지는 것은 **테이블과 제약뿐**이다.
//
// ⛔ Application service·API·permission·route policy·AuditLog action 을 만들지 않는다.
// ⛔ 적용기간 CHECK(`effective_from <= effective_to`)·overlap EXCLUDE·자동 마감·
//    current flag 를 두지 않는다 — authoritative 문서에 근거가 없다.
// ⛔ `external_product_code` 에 not-blank/trim CHECK 를 두지 않는다 —
//    조건부 UNIQUE predicate 가 빈 문자열을 **명시적으로 허용**(제외)하므로 모순이다.
// ═══════════════════════════════════════════════════════════════

/// 외부시스템 매핑의 판정 상태.
///
/// `REVIEW_REQUIRED`(상품명 기반)는 자동 원장 반영 대상이 아니다 (재고 PRD §20.5).
/// 판정 로직 자체는 T05-2 범위이며, T05-1 은 값 집합만 고정한다.
/// ⛔ 값을 추가하지 않는다 — 원 설계의 3값이 authoritative 다.
enum MappingStatus {
  MATCHED
  UNMATCHED
  REVIEW_REQUIRED
}

/// 외부시스템 정의 (LEGACY_ERP, EBUT_MANAGER, OLPUN, PUMGO, RODIT, OLIVEYOUNG …).
///
/// ⚠️ `systemName` 에 길이 제한을 두지 않는다 — 원 선언이 `String`(PostgreSQL TEXT) 이다.
/// ⚠️ `systemType` 도 String 이다. 주석의 `ERP / WMS / THREE_PL / CHANNEL` 은 **예시**이며
///    authoritative enum 이 아니다 — `ExternalSystemType` 같은 enum 을 만들지 않는다.
/// ⛔ 감사 컬럼(`createdAt`·`createdBy`·`updatedAt`·`updatedBy`·`deletedAt`)을 두지 않는다.
///    일반 ERD 감사 컬럼 규약과 충돌하지만, **모델별 명시 선언이 우선**한다는
///    T04-1 과 동일한 원칙을 Design Recovery Decision 으로 확정했다.
/// ⛔ `snapshots ExternalInventorySnapshot[]` 은 T17-1 에서 양쪽 relation 을 함께 추가한다 —
///    T17-1 의 선행조건이 T05-1 이므로 여기서 stub 을 먼저 만들면 의존이 역전된다.
model ExternalSystem {
  id         String  @id @default(uuid()) @db.Uuid
  systemCode String  @unique @map("system_code") @db.VarChar(50)
  systemName String  @map("system_name")
  systemType String  @map("system_type") @db.VarChar(30)
  active     Boolean @default(true)

  mappings SkuExternalMapping[]

  /// `Warehouse.externalSystem` 의 필수 inverse (T08-1, W-D14).
  /// ⛔ 신규 업무 필드가 아니며 어떤 API 도 이 관계를 include 하지 않는다.
  warehouses Warehouse[]

  @@map("external_system")
}

/// 내부 SKU ↔ 외부 상품코드·상품명.
///
/// 조건부 UNIQUE 2종은 Prisma 스키마 언어로 표현할 수 없어 migration 의
/// **raw SQL** 로 추가한다 (서로 다른 규칙이며 하나로 합치지 않는다):
///   - `ux_external_mapping_code`
///     : `UNIQUE(external_system_id, external_product_code)`
///       `WHERE external_product_code <> '' AND effective_to IS NULL`
///     → **현행(미종료)** 매핑에 한해 시스템별 외부코드 중복 차단
///   - `ux_external_mapping_primary`
///     : `UNIQUE(sku_id, external_system_id) WHERE is_primary = true`
///     → SKU × 외부시스템당 대표 매핑 1개. **`effective_to` 와 무관**하다
///       (Barcode 의 primary predicate 를 복사하지 않는다).
model SkuExternalMapping {
  id               String @id @default(uuid()) @db.Uuid
  skuId            String @map("sku_id") @db.Uuid
  externalSystemId String @map("external_system_id") @db.Uuid

  /// T05-1 Design Recovery 가 staged scalar 로 남겼고, **T08-1 이 real FK 로
  /// landing 했다** (docs/19 §W-D15 #1). ⛔ 이 컬럼을 삭제하지 말 것 —
  /// 원 설계에 명시된 3PL scope 다.
  /// ⚠️ FK 가 생겼을 뿐 **public API 계약은 그대로다** — `warehouseId` 입력은
  ///    여전히 400 이고 저장값은 항상 null 이다 (docs/13 §5).
  warehouseId String? @map("warehouse_id") @db.Uuid

  /// NULL 과 빈 문자열이 **모두** 허용된다 — 둘 다 조건부 UNIQUE predicate 밖이다.
  externalProductCode String? @map("external_product_code") @db.VarChar(150)
  /// 외부 원문명이다. 내부 표준 상품명(`sku.sku_name`)을 절대 덮어쓰지 않는다 (PRD §38).
  externalProductName String? @map("external_product_name") @db.VarChar(500)
  externalBarcode     String? @map("external_barcode") @db.VarChar(100)

  mappingStatus MappingStatus @default(REVIEW_REQUIRED) @map("mapping_status")
  isPrimary     Boolean       @default(false) @map("is_primary")

  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  note          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 마스터는 물리삭제 대상이 아니다 — 매핑이 딸려 지워지면 안 되므로 RESTRICT (CASCADE 금지).
  sku            Sku            @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  externalSystem ExternalSystem @relation(fields: [externalSystemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// T08-1 landing (W-D15 #1). nullable optional FK — RESTRICT.
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([skuId])
  @@index([externalSystemId, mappingStatus])
  @@map("sku_external_mapping")
}

// ═══════════════════════════════════════════════════════════════
// 공용 멱등성 (T1-3 보완)
// ═══════════════════════════════════════════════════════════════

/// 멱등 요청 기록 — **공용 인프라** (SKU 전용이 아니다).
///
/// 전역 계약:
///   - 동일 scope + 동일 key + 동일 request hash → 저장된 최초 결과 replay (HTTP 200)
///   - 동일 scope + 동일 key + 다른 request hash → 409 IDEMPOTENCY_KEY_REUSED
///
/// 멱등 scope = (actor_id, http_method, route_scope, idempotency_key).
/// key 단독이 아니다 — 다른 actor·다른 endpoint 의 동일 key 는 서로 독립이며,
/// 다른 사용자의 응답이 replay 되는 일이 없어야 한다.
///
/// `route_scope` 는 raw URL 이 아니라 **정규화된 route template** ("/api/skus")이다.
///
/// claim 과 business 작업과 response snapshot 저장은 **하나의 트랜잭션**이다.
/// 실패하면 전부 함께 롤백되므로 영속 "IN_PROGRESS" 상태가 필요 없다
/// (TTL·cleanup·상태 컬럼은 현재 요구사항에 없어 두지 않는다 — 운영 retention 은 별도 결정).
model IdempotencyRecord {
  id             String @id @default(uuid()) @db.Uuid
  actorId        String @map("actor_id") @db.Uuid
  httpMethod     String @map("http_method") @db.VarChar(10)
  routeScope     String @map("route_scope") @db.VarChar(200)
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)
  /// 검증된 DTO 의 canonical JSON 에 대한 SHA-256 hex (64자, DB CHECK).
  requestHash    String @map("request_hash") @db.Char(64)

  /// reservation 시점에는 NULL — 같은 트랜잭션에서 business 성공 후 반드시
  /// 채워져 commit 된다. 커밋된 행에서 NULL 인 경우는 없다.
  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 멱등 기록은 응답 replay 의 근거다 — 사용자 삭제에 딸려 지워지면 안 된다
  /// (AuditLog.actor_id 와 같은 RESTRICT 정책).
  actor User @relation("IdempotencyActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, httpMethod, routeScope, idempotencyKey], map: "idempotency_record_scope_key")
  @@map("idempotency_record")
}

// ═══════════════════════════════════════════════════════════════
// 거래처 · 공급조건 · 가격이력 (T06-1)
//
// 설계 문서: docs/17_설계복구_거래처공급조건.md
//   (2026-08-12 Supplier / SupplierSku / SupplierSkuPrice Design Recovery
//    Decision — D-1 ~ D-25)
// 원 설계: docs/03_ERD와_Prisma스키마.md §Layer 1(SUPPLIER · SUPPLIER_SKU ·
//          SUPPLIER_SKU_PRICE) 및 §고유조건·인덱스의 supplier_sku 행.
//
// T06-1 은 **테이블과 DB 제약까지만** 만든다.
//   - T06-2 공급조건 API
//   - T06-3 가격이력 API + asOf 유효가격 + 승인
//   - T06-4 거래처·공급조건 화면
// 은 범위가 아니다. permission·seed·UI·AuditLog producer 도 만들지 않는다.
//
// ⛔ `SupplierType` / `SupplierStatus` enum 을 만들지 않는다 — 원 선언이 String 이며
//    주석의 값들은 **예시**다 (`ExternalSystem.systemType` 과 동일한 판단).
// ⛔ `Warehouse` / `Attachment` 모델·FK·stub 을 만들지 않는다 — 각각 T08-1 과
//    미배정 future capability 다. 세 scalar 는 **의도된 staged state** 이며
//    FK 누락이 아니다 (docs/17 §8·§14·§28).
// ⛔ `SupplierSkuPrice` 에 EXCLUDE 를 걸지 않는다 — 가격이력의 계약은 공급조건과
//    다르다(동일 적용일 중복 차단 + 이전 가격 자동 마감, docs/17 §21).
// ═══════════════════════════════════════════════════════════════

/// 공급 형태. 사급(자재를 발주사가 지급) / 턴키(공급자 일괄).
/// ⛔ 세 번째 값을 추가하지 않는다 (docs/03 §enum, docs/17 §11).
enum SupplyType {
  SELF_SUPPLIED
  TURNKEY
}

/// 공급업체 · 제조사 (실측 40개사).
///
/// ⛔ `createdBy`·`updatedBy`·`approvedBy`·`deletedAt` 이 없다 — 원 모델 선언에
///    없으며, **모델별 명시 선언이 일반 감사 컬럼 규약보다 우선**한다는
///    T04-1·T05-1 의 원칙을 유지한다 (docs/17 §2).
/// ⛔ `warehouses Warehouse[]` inverse 는 T08-1 이다.
model Supplier {
  id String @id @default(uuid()) @db.Uuid

  /// 전역 UNIQUE. 빈 문자열·앞뒤 공백만 있는 값 금지 (DB CHECK).
  supplierCode String @unique @map("supplier_code") @db.VarChar(50)
  supplierName String @map("supplier_name") @db.VarChar(150)

  /// ★ **열거값이 아니다.** MANUFACTURER / VENDOR / THREE_PL / FORWARDER 는
  ///   known examples 이며 DB 는 blank 만 막는다. 허용값 제한이 필요한지는
  ///   T06-2 API 계약의 몫이다 (docs/17 §4).
  supplierType String @map("supplier_type") @db.VarChar(30)

  /// ⛔ UNIQUE 를 두지 않는다 — 근거 없음.
  businessRegistrationNo String? @map("business_registration_no") @db.VarChar(30)

  /// ⛔ email format DB CHECK 없음 — 프로젝트에 선례가 없다.
  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")

  /// ★ nullable = **미입력/미확정**. `0` 은 명시적 0일이며 서로 다른 값이다.
  ///   ⛔ null 을 0 으로 자동 변환 금지 (§00 G-03). 음수만 CHECK 로 막는다.
  defaultLeadTimeDays Int? @map("default_lead_time_days")

  /// T06-1 이 staged scalar 로 남겼고 **T08-1 이 real FK 로 landing 했다**
  /// (docs/19 §W-D15 #2). 이제 존재하지 않는 UUID 는 DB 가 거부한다.
  /// ⚠️ FK 만 생겼다 — T06-2 public API 는 여전히 이 필드를 받지 않는다.
  defaultWarehouseId String? @map("default_warehouse_id") @db.Uuid

  /// ★ 허용값 allow-list CHECK 없음 — blank 만 막는다 (docs/17 §5).
  ///   ACTIVE/INACTIVE 워크플로·archive·비활성화 검증은 T06-2 다.
  status String  @default("ACTIVE") @db.VarChar(20)
  note   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  supplierSkus SupplierSku[]

  /// BOM 조립처 (T07-1). `BomHeader.productionPartner` 의 필수 inverse relation
  /// 이며 신규 업무 컬럼이 아니다. ⛔ Supplier business logic 은 그대로다.
  bomHeaders BomHeader[] @relation("BomProductionPartner")

  /// T08-1 landing (W-D15 #2). ⚠️ 아래 `supplierSiteWarehouses` 와 **완전히
  /// 다른 관계**다 — 이쪽은 "이 거래처가 기본 입고처로 쓰는 창고" 이고,
  /// 저쪽은 "이 거래처가 사급자재를 보관하는 SUPPLIER_SITE 창고" 다.
  defaultWarehouse Warehouse? @relation("SupplierDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// `Warehouse.supplier`(SUPPLIER_SITE) 의 필수 inverse (T08-1, W-D13).
  /// ⚠️ Phase 7(`T4-19`) 전까지 11개 SUPPLIER_SITE 창고는 이 관계가 비어 있다.
  supplierSiteWarehouses Warehouse[] @relation("WarehouseSupplierSite")

  @@map("supplier")
}

/// 공급업체별 SKU 공급조건. **적용기간을 갖는 이력형 모델**이다.
///
/// 적용기간은 **half-open** `[effectiveFrom, effectiveTo)` 다 (docs/17 §16):
///   - `effectiveFrom` 포함 / `effectiveTo` 미포함
///   - `effectiveTo IS NULL` = 무기한
///   - 따라서 `~02-01` 과 `02-01~` 은 **겹치지 않는다** (같은 날 교대 허용)
///
/// 중첩 차단은 DB 가 한다 — migration raw SQL 의
/// `supplier_sku_effective_period_excl` (`EXCLUDE USING gist`).
/// Prisma 는 EXCLUDE 를 표현하지 못한다.
///
/// ⛔ `updatedAt`·`status`·`deletedAt`·actor 컬럼이 없다 — 원 선언 그대로다.
/// ⛔ `unitConversionQty` 를 넣지 않는다 — docs/03 ERD 블록에만 있고
///    authoritative Prisma 블록에는 없다 (docs/17 §9).
model SupplierSku {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  skuId      String @map("sku_id") @db.Uuid

  supplierSkuCode String? @map("supplier_sku_code") @db.VarChar(100)
  supplierSkuName String? @map("supplier_sku_name") @db.VarChar(255)

  /// ★ DB default 는 `SELF_SUPPLIED` 지만, 이것이 T06-2 API 를 optional 로
  ///   만드는 근거는 아니다 — API 계약은 별도다 (docs/17 §11).
  supplyType SupplyType @default(SELF_SUPPLIED) @map("supply_type")

  /// null = 미지정. 값이 있으면 **0 보다 커야 한다** (DB CHECK).
  /// ⛔ 0 을 "미지정" 으로 쓰지 않는다.
  moq           Decimal? @db.Decimal(18, 6)
  orderMultiple Decimal? @map("order_multiple") @db.Decimal(18, 6)

  /// ★ 실측 383행 중 2행만 입력됨. nullable 필수 (§00 G-03).
  ///   `Supplier.defaultLeadTimeDays` 와 동일 semantics — 0 은 유효값이다.
  leadTimeDays Int? @map("lead_time_days")

  /// free string 이다. ⛔ CommonCode FK·`Sku.purchaseUom` 자동 상속·default 없음.
  purchaseUom String? @map("purchase_uom") @db.VarChar(20)

  /// T06-1 staged scalar → **T08-1 real FK landing** (docs/19 §W-D15 #3).
  /// ⚠️ T06-2/T06-3 public API 계약은 그대로다 — 입력을 받지 않는다.
  destinationWarehouseId String? @map("destination_warehouse_id") @db.Uuid

  /// ⛔ ISO 4217 enum·CommonCode·uppercase CHECK 없음. blank 만 막는다.
  ///   `SupplierSkuPrice.currency` 와 **독립 저장값**이며 자동 동기화하지 않는다.
  currency String @default("KRW") @db.VarChar(3)

  /// 우선공급업체. 불변식은 partial UNIQUE `ux_supplier_sku_primary_current`:
  /// **현재 미종료(`effective_to IS NULL`) 행 중 SKU 당 1개**.
  /// ★ 종료된 과거 primary 는 새 primary 를 막지 않는다
  ///   (`ux_external_mapping_primary` 와 정반대다 — 복사하지 말 것).
  /// ⚠️ 시작일이 미래여도 `effective_to IS NULL` 이면 이 UNIQUE 대상이다.
  ///    원 predicate 에 `effective_from <= today` 가 없어 그대로 채택했고,
  ///    scheduled primary 가 필요해지면 별도 Recovery 다 (docs/17 §23).
  isPrimary Boolean @default(false) @map("is_primary")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 마스터는 물리삭제 대상이 아니다 — 공급조건이 딸려 지워지면 안 되므로 RESTRICT.
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sku      Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// T08-1 landing (W-D15 #3). nullable optional FK — RESTRICT.
  destinationWarehouse Warehouse? @relation(fields: [destinationWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  prices SupplierSkuPrice[]

  /// ★ EXCLUDE 가 있어도 **삭제하지 않는다** — surviving source 보존
  ///   (docs/03 §고유조건, docs/17 §19). 역할이 겹쳐 보여도 유지한다.
  @@unique([supplierId, skuId, effectiveFrom])
  @@index([skuId])
  @@map("supplier_sku")
}

/// 공급조건별 가격 이력.
///
/// ★ 승인 상태는 **`approvedBy` 의 null 여부**로 표현한다 (docs/17 §26):
///     `approvedBy IS NULL`     = 미승인
///     `approvedBy IS NOT NULL` = 승인 완료
/// ⛔ `approvalStatus`·`approvedAt`·`rejectedBy`·`rejectedAt`·`status` 컬럼을
///    만들지 않는다. 승인 시각은 T06-3 이 남길 AuditLog `occurredAt` 으로 추적한다.
/// ⛔ 반려 상태·반려 endpoint 는 authoritative source 가 없어 만들지 않는다.
///
/// ⛔ **EXCLUDE 를 걸지 않는다.** 가격은 `UNIQUE(supplier_sku_id, effective_from)`
///    로 동일 적용일만 막고, 이전 가격의 `effectiveTo` 자동 마감을 T06-3
///    application transaction 이 수행한다 (docs/05 §10.6, docs/17 §21).
model SupplierSkuPrice {
  id            String @id @default(uuid()) @db.Uuid
  supplierSkuId String @map("supplier_sku_id") @db.Uuid

  /// ★ 정밀도가 `moq`(18,6) 과 다르다 — 금액이므로 (18,4) 다.
  /// ⛔ positive CHECK 를 두지 않는다 — 금액 semantics 는 T06-3 DTO 의 몫이다.
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  currency    String  @default("KRW") @db.VarChar(3)
  vatIncluded Boolean @default(false) @map("vat_included")

  /// `SupplierSku` 와 동일한 half-open `[from, to)` semantics.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  sourceDocument String? @map("source_document") @db.VarChar(255)

  /// ★ **staged scalar** — `attachment` 테이블이 없다. FK·relation·stub 없음.
  ///   Attachment capability 가 정식 구현될 때 FK 를 연결한다 (docs/17 §28).
  attachmentId String? @map("attachment_id") @db.Uuid

  createdBy  String? @map("created_by") @db.Uuid
  approvedBy String? @map("approved_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 가격 이력을 부모 삭제에 딸려 물리삭제하지 않는다 — CASCADE 금지.
  supplierSku SupplierSku @relation(fields: [supplierSkuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// ★ actor 는 **RESTRICT** 다 (Sku 의 SET NULL 과 다르다).
  ///   `approvedBy` 가 승인 상태 자체이므로, 사용자 삭제로 SET NULL 되면
  ///   승인된 가격이 미승인으로 뒤집힌다 (docs/17 §30).
  createdByUser  User? @relation("SupplierSkuPriceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedByUser User? @relation("SupplierSkuPriceApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([supplierSkuId, effectiveFrom])
  @@index([supplierSkuId, effectiveFrom(sort: Desc)])
  @@map("supplier_sku_price")
}

// ═══════════════════════════════════════════════════════════════
// BOM — 헤더 · 라인 (T07-1)
//
// 설계 문서: docs/18_설계복구_BOM.md
//   (2026-08-13 BOM Design Recovery Decision — D-1 ~ D-32)
// 원 설계: docs/03_ERD와_Prisma스키마_v0.2.md §Layer 2(BOM_HEADER · BOM_LINE)
//          및 §고유조건·인덱스의 bom_header / bom_line 행.
//
// T07-1 은 **테이블과 DB 제약까지만** 만든다.
//   - T07-2 도메인(순환 탐지 · 검증규칙 14종 · resolveEffectiveBom)
//   - T07-3 CRUD API · permission · route-policy · audit · 멱등
//   - T07-4 소요량 관리   - T07-5 승인·활성화·복사 워크플로
//   - T07-6 다단계 전개   - T07-7 원가   - T07-8 화면
// 은 범위가 아니다.
//
// ⛔ `Warehouse` 모델·FK·stub 을 만들지 않는다 — `destinationWarehouseId`·
//    `issueWarehouseId` 는 T08-1 까지 **의도된 staged scalar** 다 (docs/18 §D-32,
//    docs/17 §14 선례).
// ⛔ `Attachment` 필드를 만들지 않는다 — BOM scope 0 (docs/18 §D-32).
// ⛔ 상태 전이·활성 교체(predecessor 기간 마감)를 DB trigger 로 구현하지 않는다.
//    `activate` 의 chain mutation 은 **application(T07-5)** 의 몫이다 (docs/18 §D-7).
// ⛔ 순환 탐지를 DB 로 구현하지 않는다 — 불가능하며 T07-2 의 DFS + advisory lock
//    이 담당한다 (docs/18 §D-13·§D-28).
// ═══════════════════════════════════════════════════════════════

/// BOM 상태 7종. 전이 그래프는 T07-5 가 구현한다 (docs/18 §D-6).
///
/// ★ `ACTIVE` 는 "지금 유효"가 아니라 **"적용기간이 발효 승인됨"** 이다.
///   어느 시점에 실제로 유효한지는 `[effectiveFrom, effectiveTo)` 와 asOf 가
///   정한다 (docs/18 §D-7). `INACTIVE` 는 명시적 `deactivate` 전용이며
///   버전 교체의 부작용으로 발생하지 않는다.
/// ⛔ 값을 추가·삭제하지 않는다.
enum BomStatus {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  APPROVED
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// BOM 유형 3종. ⛔ 네 번째 값을 추가하지 않는다.
enum BomType {
  MANUFACTURING
  KIT
  REPACK
}

/// 구성품 역할 4종.
/// ★ `SERVICE` 는 임가공비처럼 **재고관리 대상이 아닌** 라인이다
///   (`01:193` 조립 임가공 464원). 허용값이며 배제하지 않는다.
enum ComponentRole {
  PRODUCT
  MATERIAL
  PACKAGING
  SERVICE
}

/// 소요량 확정 단계 3종 (§00 G-02).
/// `SUGGESTED` 는 **마이그레이션이 `1 ÷ packQuantity` 로 자동 생성**한 값을 뜻하며,
/// 사람이 수락하면 `CONFIRMED` 다 (docs/18 §D-10). 정합 규칙은 T07-4 다.
enum QuantityStatus {
  CONFIRMED
  SUGGESTED
  UNKNOWN
}

/// BOM 헤더 — 상위 SKU 의 한 버전. 실측 80 헤더 / 383 라인.
///
/// 적용기간은 **half-open `[effectiveFrom, effectiveTo)`** 다.
/// `status='ACTIVE'` 인 행끼리만 기간 중첩이 EXCLUDE 로 차단된다 —
/// DRAFT/PENDING_APPROVAL/APPROVED 는 여러 후보 버전을 동시에 준비할 수 있으므로
/// 중첩이 허용된다 (docs/18 §D-5). ⚠️ `SupplierSku` 의 EXCLUDE 는 status 조건이
/// 없다 — **복사하지 말 것.**
model BomHeader {
  id String @id @default(uuid()) @db.Uuid

  /// 상위 SKU. 마스터는 물리삭제 대상이 아니므로 RESTRICT.
  parentSkuId String @map("parent_sku_id") @db.Uuid

  bomType BomType @map("bom_type")

  /// ★ **client 가 준다.** 서버 자동 채번·semantic version 파싱 없다 (docs/18 §D-4).
  ///   `(parentSkuId, version)` UNIQUE 이며 **case-sensitive** 다.
  ///   ⛔ 정렬에 쓰지 않는다 — 버전 순서는 `effectiveFrom` 이 정한다.
  version String @db.VarChar(20)

  status BomStatus @default(DRAFT)

  /// 이 BOM 1회 실행의 **산출 수량**. `quantityPer` 는 이 수량 기준이다.
  /// 소요량 계산식은 T07-6 이 구현한다 (docs/18 §D-19).
  outputQty Decimal @default(1) @map("output_qty") @db.Decimal(18, 6)

  /// 상위 SKU 의 `baseUom` 과 같아야 한다 — 강제는 application(T07-3)이다.
  /// ⛔ BOM 은 단위 환산을 하지 않는다 (docs/18 §D-11).
  outputUom String @map("output_uom") @db.VarChar(20)

  /// ★ `DRAFT` 여도 **필수**다. 서버가 오늘로 채우지 않는다 (docs/18 §D-5).
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// 조립처(제조사). `Supplier` 가 이미 존재하므로 **FK 로 연결**한다
  /// — staged scalar 가 아니다 (docs/18 §D-2, `01:157` P열 매핑).
  productionPartnerId String? @map("production_partner_id") @db.Uuid

  /// T07-1 staged scalar → **T08-1 real FK landing** (docs/19 §W-D15 #4).
  /// ⚠️ T07 public `BomView`/`BomDetail` 은 그대로다 — 이름 join 없음,
  ///    relation 객체 자동 include 없음 (docs/18 §D-31·§D-32).
  destinationWarehouseId String? @map("destination_warehouse_id") @db.Uuid

  /// 전체 로스율. null = 0 으로 본다 (⛔ 임의 추정 금지, `01:190`).
  overallLossRate Decimal? @map("overall_loss_rate") @db.Decimal(8, 6)

  description  String?
  /// clone(버전 생성) 시 필수 — 강제는 T07-5 다.
  changeReason String? @map("change_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// ★ actor 는 **RESTRICT** 다 (`Sku` 의 SET NULL 과 다르다).
  ///   `approvedBy` 는 승인 사실 자체이므로 사용자 삭제로 지워지면 안 된다
  ///   (`SupplierSkuPrice` 와 같은 판단, docs/17 §30).
  createdBy   String?   @map("created_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz
  approvedBy  String?   @map("approved_by") @db.Uuid
  activatedAt DateTime? @map("activated_at") @db.Timestamptz

  parentSku         Sku       @relation("BomParent", fields: [parentSkuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productionPartner Supplier? @relation("BomProductionPartner", fields: [productionPartnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser     User?     @relation("BomHeaderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedByUser    User?     @relation("BomHeaderApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// T08-1 landing (W-D15 #4). nullable optional FK — RESTRICT.
  destinationWarehouse Warehouse? @relation(fields: [destinationWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  lines BomLine[]
  // raw SQL (migration 참조):
  //   1) CHECK   bom_header_effective_period_check
  //        effective_to IS NULL OR effective_to > effective_from
  //   2) EXCLUDE bom_header_active_period_excl  ★ WHERE (status = 'ACTIVE')
  //        (parent_sku_id WITH =, daterange(effective_from, effective_to, '[)') WITH &&)

  @@unique([parentSkuId, version])
  @@index([parentSkuId, status])
  @@map("bom_header")
}

/// BOM 라인 — 한 버전의 구성품 한 줄.
///
/// ★ `packQuantity`(포장 입수량)와 `quantityPer`(소요량)는 **물리적으로 다른
///   컬럼**이다. 아웃박스 30개입이면 `packQuantity=30` / `quantityPer=1/30`
///   이며, `1 ÷ packQuantity` 는 **UI 추천값일 뿐** 자동 전환하지 않는다
///   (`01:188`, F-19, docs/18 §D-10). ⛔ 소요량 없는 행에 1 을 채우지 않는다.
model BomLine {
  id String @id @default(uuid()) @db.Uuid

  /// 이력을 부모 삭제에 딸려 물리삭제하지 않는다 — CASCADE 금지.
  bomHeaderId String @map("bom_header_id") @db.Uuid

  /// BOM 안에서 UNIQUE. 다른 헤더라면 같은 번호를 써도 된다.
  lineNo Int @map("line_no")

  componentSkuId String @map("component_sku_id") @db.Uuid

  /// ★ `DRAFT` 는 NULL 허용 — 원본 엑셀 383행에 소요량 컬럼 자체가 없다(G-02).
  ///   `> 0` 강제와 `quantityStatus` 정합은 **T07-4 application** 의 몫이다.
  ///   ⛔ 자동 1 입력 금지.
  quantityPer    Decimal?       @map("quantity_per") @db.Decimal(18, 6)
  quantityStatus QuantityStatus @default(UNKNOWN) @map("quantity_status")

  /// 구성품 SKU 의 `baseUom` 과 같아야 한다 — 강제는 T07-3 이다 (docs/18 §D-11).
  uom String @db.VarChar(20)

  /// 라인 손실률. null = 0 (⛔ 임의 추정 금지).
  lossRate Decimal? @map("loss_rate") @db.Decimal(8, 6)

  componentRole ComponentRole @map("component_role")

  /// 기존 enum 재사용 — BOM 전용 enum 을 만들지 않는다.
  supplyType SupplyType? @map("supply_type")

  /// 대체 부자재 그룹. ★ 중복 방지는 표현식 UNIQUE
  /// `ux_bom_line_component_group (bom_header_id, component_sku_id,
  /// COALESCE(alternate_group, ''))` 이며 **NULL 끼리도 같은 그룹**으로 본다
  /// (docs/18 §D-3). 센티넬 `''` 은 인덱스 전용이고 **business value 가 아니다**
  /// — `alternate_group = ''` 인 행은 존재하지 않는다(blank→null 정규화는 T07-3).
  /// ⛔ `NOT NULL DEFAULT ''` 로 바꾸지 않는다.
  alternateGroup String? @map("alternate_group") @db.VarChar(50)

  isRequired Boolean @default(true) @map("is_required")

  /// T07-1 staged scalar → **T08-1 real FK landing** (docs/19 §W-D15 #5).
  /// ⚠️ T07 라인 public projection 은 그대로다 — scalar UUID 그대로 노출하고
  ///    relation 을 자동 include 하지 않는다 (docs/18 §D-31·§D-32).
  issueWarehouseId String? @map("issue_warehouse_id") @db.Uuid

  /// ★ 포장 입수량. **소요량이 아니다** (위 모델 주석 참조).
  packQuantity Decimal? @map("pack_quantity") @db.Decimal(18, 6)

  specification String?

  /// 마이그레이션 추적 전용 (Phase 8, R1a-4). API 입력 대상이 아니다.
  legacyBomCode       String? @map("legacy_bom_code") @db.VarChar(100)
  legacyCommonBomCode String? @map("legacy_common_bom_code") @db.VarChar(100)

  note String?

  bomHeader    BomHeader @relation(fields: [bomHeaderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  componentSku Sku       @relation("BomComponent", fields: [componentSkuId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// T08-1 landing (W-D15 #5). nullable optional FK — RESTRICT.
  issueWarehouse Warehouse? @relation(fields: [issueWarehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // raw SQL (migration 참조):
  //   3) UNIQUE INDEX ux_bom_line_component_group
  //        (bom_header_id, component_sku_id, COALESCE(alternate_group, ''))

  @@unique([bomHeaderId, lineNo])
  /// 역전개(where-used)용. T07-3 `hasBomUsage` provider 가 이 인덱스를 탄다.
  @@index([componentSkuId])
  @@map("bom_line")
}

// ═══════════════════════════════════════════════════════════════
// 창고 · 로케이션 (T08-1 = v0.2 T2-1A)
//
// 설계 문서: docs/19_설계복구_Warehouse.md (W-D1 ~ W-D42)
//            원 설계는 docs/03_ERD와_Prisma스키마_v0.2.md §Layer 1(창고).
//
// T08-1 은 **테이블 · DB 제약 · relation landing 까지만** 만든다.
// application service · API · DTO · permission · route-policy · seed 15종 ·
// DEFAULT 자동생성 flow · UI(T2-20) 는 전부 T08-2 이후다 (W-D1).
//
// ── ★ defaultLocationId 는 NOT NULL 이다 (W-D5) ─────────────────────
// `docs/03` 의 Prisma 블록은 `String?` 이었으나 같은 문서 §6.2 ERD 와
// `docs/00 §2.2 G-05` 가 **NOT NULL** 을 명시한다 → NOT NULL 이 정본이다.
//
// ── ★ same-warehouse composite FK (W-D6) ───────────────────────────
// 단일 `default_location_id → warehouse_location.id` FK 는 **다른 창고의**
// 로케이션을 default 로 지정하는 것을 막지 못한다. 그래서 2열 FK 를 건다:
//
//     FOREIGN KEY (id, default_location_id)
//     REFERENCES warehouse_location (warehouse_id, id)
//     DEFERRABLE INITIALLY DEFERRED
//
// 첫 열이 `warehouse.id = warehouse_location.warehouse_id` 를 강제하므로
// **DEFAULT 로케이션은 반드시 그 창고 소속**이다.
//
// ── ★ 순환 참조와 DEFERRABLE (W-D7) ────────────────────────────────
// warehouse ↔ warehouse_location 은 서로를 참조한다. T08-2 의 생성
// 트랜잭션은 location UUID 를 **미리 만들어** warehouse 를 먼저 INSERT 하고
// location 을 이어서 INSERT 한 뒤 COMMIT 에서 검증받는다 — 사후 UPDATE 가
// 없다. 그것이 가능하려면 이 FK 가 `DEFERRABLE INITIALLY DEFERRED` 여야 한다.
// ⛔ Prisma 는 deferrability 를 표현하지 못하므로 migration raw SQL 이 담당한다.
//
// ── ★ Supplier staged link — one-way CHECK 만 (W-D13) ──────────────
//     CHECK (supplier_id IS NULL OR warehouse_type = 'SUPPLIER_SITE')
//
// `SUPPLIER_SITE` + `supplier_id IS NULL` 은 **허용되는 transitional state**
// 다. 거래처 정본은 마이그레이션 Phase 7(`T4-19`)에만 있어서 창고 seed
// 시점에는 연결할 대상이 없다.
// ⛔ 역방향 CHECK(`warehouse_type <> 'SUPPLIER_SITE' OR supplier_id IS NOT NULL`)
//    를 T08 에서 추가하지 않는다 — seed 11건이 즉시 실패한다. two-way IFF 는
//    11건 backfill 이 끝난 뒤 `T4-19` 가 추가한다 (W-D13 최종 운영 불변식).
//
// ⛔ T09 관계를 만들지 않는다 — `InventoryLedgerEntry` · `InventoryBalance` ·
//    `ledgerEntries` · `balances` 는 전부 T09 소유다 (W-D18 · W-D40).
// ⛔ `createdBy`·`updatedBy`·`deletedAt`·`version`·재고 캐시 컬럼 없음.
// ⛔ seed row 0 — 15종 창고 · `DEFAULT` 로케이션 · `IN_TRANSIT` 은 T08-2 다.
// ═══════════════════════════════════════════════════════════════

/// 창고 유형 — **정확히 6종**이다 (W-D2).
/// `docs/03` v0.1·v0.2 가 완전히 동일하며 ⛔ 그 외 값을 추가하지 않는다.
enum WarehouseType {
  INTERNAL
  THREE_PL
  SUPPLIER_SITE
  OVERSEAS
  VIRTUAL
  IN_TRANSIT
}

/// 재고 보관 장소. 재고키(`(sku, warehouse, location, ...)`)의 한 축이다.
///
/// ★ 모든 창고는 `DEFAULT` 로케이션을 정확히 1개 가지며 `defaultLocationId`
///   가 그것을 가리킨다 (§00 G-05). 그 로케이션은 **반드시 같은 창고 소속**
///   이며 composite FK 가 이를 강제한다 (W-D6).
model Warehouse {
  id String @id @default(uuid()) @db.Uuid

  /// 전역 UNIQUE. blank 금지는 DB CHECK 가 맡는다 (`supplier_code` 선례).
  warehouseCode String        @unique @map("warehouse_code") @db.VarChar(50)
  warehouseName String        @map("warehouse_name") @db.VarChar(150)
  warehouseType WarehouseType @map("warehouse_type")

  /// 연동 외부시스템. ⛔ 특정 유형에서 required 로 만들지 않는다 — 근거가
  ///   없다 (W-D14). T08-2 seed 는 15건 전부 `null` 이다.
  externalSystemId String? @map("external_system_id") @db.Uuid

  /// `SUPPLIER_SITE`(제조사 보관 사급자재) 창고의 거래처 (§00 G-10 · D-02).
  /// ★ `SUPPLIER_SITE` + `null` 은 **정상 transitional state** 다 (W-D13).
  ///   ⛔ null 이라는 이유로 corruption 취급하지 않는다.
  supplierId String? @map("supplier_id") @db.Uuid

  /// ★ **NOT NULL** 이다 (W-D5). nullable 초안은 supersede 되었다.
  ///   같은 창고의 로케이션만 가리킬 수 있다 (W-D6 composite FK).
  defaultLocationId String @map("default_location_id") @db.Uuid

  /// 업무일자(`business_date`) 파생 기준 (§00 G-08). ⛔ explicit null 금지.
  timezone String  @default("Asia/Seoul") @db.VarChar(50)
  address  String?
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// 마스터는 물리삭제 대상이 아니다 — RESTRICT (CASCADE 금지, W-D19).
  supplier       Supplier?       @relation("WarehouseSupplierSite", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  externalSystem ExternalSystem? @relation(fields: [externalSystemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// ★ composite relation — `(id, defaultLocationId)` → `(warehouseId, id)`.
  ///   ⛔ `defaultLocationId → WarehouseLocation.id` 단일 FK 로 바꾸지 않는다.
  ///      그러면 다른 창고의 로케이션을 default 로 지정할 수 있다.
  defaultLocation WarehouseLocation @relation("WarehouseDefaultLocation", fields: [id, defaultLocationId], references: [warehouseId, id], onDelete: Restrict, onUpdate: Cascade)

  locations WarehouseLocation[] @relation("WarehouseLocations")

  /// ── staged scalar 5종의 inverse (W-D15) ──────────────────────────
  /// ⚠️ relation field 추가는 **public API projection 추가가 아니다**.
  ///    ⛔ 어떤 기존 API 도 이 관계를 include 하지 않는다.
  externalMappings           SkuExternalMapping[]
  defaultForSuppliers        Supplier[]           @relation("SupplierDefaultWarehouse")
  destinationForSupplierSkus SupplierSku[]
  destinationForBomHeaders   BomHeader[]
  issueForBomLines           BomLine[]
  // raw SQL (migration 참조):
  //   1) CHECK  warehouse_code_not_blank / warehouse_name_not_blank /
  //             warehouse_timezone_not_blank
  //   2) CHECK  warehouse_supplier_site_check   ★ one-way 전용
  //        supplier_id IS NULL OR warehouse_type = 'SUPPLIER_SITE'
  //   3) UNIQUE INDEX ux_warehouse_in_transit_singleton
  //        ON warehouse ((true)) WHERE warehouse_type = 'IN_TRANSIT'
  //   4) FK warehouse_id_default_location_id_fkey 를
  //        DEFERRABLE INITIALLY DEFERRED 로 생성 (Prisma 가 못 만든다)

  /// ★ **1:1 cardinality 선언**이다 — query 성능용 인덱스가 아니다.
  ///
  /// `id` 가 PK 이므로 `(id, defaultLocationId)` 는 DB 논리상 이미 유일하고
  /// 이 UNIQUE 는 그 위에 얹히는 중복이다. 그럼에도 두는 이유는 Prisma 가
  /// **multi-field 1:1 relation 을 인정하려면 source 쪽 relation scalar 집합에
  /// `@@unique` 를 요구**하기 때문이다. 이것이 없으면 inverse 를
  /// `Warehouse[]` 로밖에 선언할 수 없어, **ORM 모델의 cardinality 가 DB
  /// 불변식보다 느슨해진다**(창고 1 ↔ DEFAULT 로케이션 1).
  /// ⛔ "중복 인덱스" 를 이유로 삭제하지 말 것 — 지우면 아래
  ///    `defaultLocation` ↔ `defaultForWarehouse` 1:1 선언이 깨진다.
  @@unique([id, defaultLocationId])
  @@map("warehouse")
}

/// 창고 내 로케이션. 로케이션을 쓰지 않는 창고도 `DEFAULT` 1개는 갖는다.
///
/// ⛔ 감사 컬럼(`createdAt`·`updatedAt`)이 없다 — 원 선언 그대로다 (W-D4).
/// ⛔ `isDefault` boolean 을 두지 않는다 — default 는 `warehouse` 쪽 FK 다.
model WarehouseLocation {
  id           String  @id @default(uuid()) @db.Uuid
  warehouseId  String  @map("warehouse_id") @db.Uuid
  /// 로케이션 미사용 창고는 `'DEFAULT'`. ★ 예약 코드다 (W-D9).
  locationCode String  @map("location_code") @db.VarChar(50)
  locationName String  @map("location_name") @db.VarChar(150)
  locationType String? @map("location_type") @db.VarChar(30)
  active       Boolean @default(true)

  warehouse Warehouse @relation("WarehouseLocations", fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// composite FK 의 inverse — **1:1** 이다.
  ///
  /// 한 로케이션이 default 인 창고는 최대 하나다: FK 의 첫 열이
  /// `warehouse.id`(PK) 이므로 구조적으로 둘이 될 수 없다. 그 사실을 ORM
  /// 모델에도 그대로 표현한다 — `Warehouse[]` 로 두면 **cardinality 가 DB
  /// 불변식보다 느슨해진다**.
  ///
  /// optional singular 인 이유: relation scalar(`defaultLocationId`) 를 가진
  /// 쪽은 `Warehouse` 이고, scalar 가 없는 inverse 는 Prisma 1:1 규칙상
  /// optional 이어야 한다. (아직 어떤 창고의 default 도 아닌 로케이션이
  /// 존재하는 것도 정상이다 — DEFAULT 가 아닌 일반 로케이션들.)
  /// ⛔ `Warehouse[]` 로 되돌리지 않는다.
  defaultForWarehouse Warehouse? @relation("WarehouseDefaultLocation")

  @@unique([warehouseId, locationCode])
  /// ★ business identity 가 아니라 **composite FK 의 참조 대상**이다 (W-D6).
  ///   `warehouse (id, default_location_id)` 가 이 UNIQUE 를 가리킨다.
  ///   ⛔ 삭제하지 말 것 — 지우면 default FK 를 걸 수 없다.
  @@unique([warehouseId, id])
  @@map("warehouse_location")
}
