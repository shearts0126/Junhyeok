# ─────────────────────────────────────────────────────────────
# DEEPPOINT SCM OS — 환경변수 예시
#
# 이 파일을 .env.local 로 복사해 사용하세요.
#   cp .env.example .env.local
#
# ⚠️ .env* 는 .gitignore 로 커밋이 차단됩니다 (.env.example 만 예외).
#    실제 시크릿을 이 파일에 적지 마세요.
#    아래 값은 전부 로컬 개발용 예시이며 운영 자격증명이 아닙니다.
# ─────────────────────────────────────────────────────────────

# ── 애플리케이션 ─────────────────────────────────────────────
# 업무일자(business_date) 파생 기준. 변경하지 마세요.
APP_TIMEZONE="Asia/Seoul"

# ── 개발 전용 (T0-3) ─────────────────────────────────────────
#
# ⚠️ 개발 전용입니다. 스테이징·운영에서는 절대 설정하지 마세요.
#
# /api/dev/error-preview 라우트를 활성화합니다.
# 오류 종류를 임의로 유발할 수 있으므로 기본값은 비활성화이며,
# NODE_ENV != 'production' 이면서 이 값이 "true" 일 때만 동작합니다.
# 비활성 상태에서는 JSON 404 를 반환합니다.
# ENABLE_ERROR_PREVIEW="true"

# ── 데이터베이스 (T0-2) ──────────────────────────────────────
#
# 두 개의 연결 문자열이 필요합니다.
#
#   DATABASE_URL : 애플리케이션 런타임용 **pooled connection**
#                  운영에서는 Supabase Supavisor(transaction mode)를 경유해
#                  서버리스 커넥션 폭증을 방지합니다.
#                  PrismaClient 의 driver adapter 가 이 값을 사용합니다.
#
#   DIRECT_URL   : 마이그레이션·워커용 **direct connection**
#                  transaction-mode pooler 에서는 DDL·prepared statement 가
#                  제한되므로 prisma migrate 는 반드시 직결을 사용합니다.
#                  prisma.config.ts 가 이 값을 사용합니다.
#
# 로컬(docker compose up -d db) 기준 예시 — 그대로 사용 가능합니다.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/deeppoint_scm"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55432/deeppoint_scm"

# 운영(Supabase) 형식 예시 — 실제 값은 저장소에 커밋하지 마세요.
#   포트 6543 = Supavisor pooler / 포트 5432 = direct
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ── 인증 (T0-6) ──────────────────────────────────────────────
#
# Supabase 프로젝트 설정 > API 에서 확인합니다.
#
#   NEXT_PUBLIC_SUPABASE_URL             프로젝트 URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY 공개용 publishable key
#
# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 **클라이언트 번들에 포함됩니다.**
#    publishable key 는 그렇게 쓰도록 설계된 공개 키입니다.
#    secret / service-role 키에는 절대 이 접두사를 붙이지 마세요.
#
# ⚠️ T0-6 은 Supabase Admin API 를 쓰지 않으므로 **secret / service-role 키가
#    필요하지 않습니다.** 관리자 사용자 생성 API 가 생기는 작업에서 서버 전용
#    secret key 를 별도로 추가합니다.
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ─────────────────────────────────────────────────────────────
# 아래 항목은 해당 작업에서 도입됩니다. 지금은 사용하지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── 파일 저장 (T4-2, R1a-4) ──────────────────────────────────
# SUPABASE_STORAGE_BUCKET_IMPORTS="imports"
# SUPABASE_STORAGE_BUCKET_EVIDENCE="evidence"
# SUPABASE_STORAGE_BUCKET_EXPORTS="exports"

# ── 비동기 잡 큐 (T4-1, R1a-4) ───────────────────────────────
# PGBOSS_DATABASE_URL=""
# PGBOSS_SCHEMA="pgboss"
