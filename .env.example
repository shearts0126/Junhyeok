# ─────────────────────────────────────────────────────────────
# DEEPPOINT SCM OS — 환경변수 예시
#
# 이 파일을 .env.local 로 복사해 사용하세요.
#   cp .env.example .env.local
#
# ⚠️ .env* 는 .gitignore 로 커밋이 차단됩니다 (.env.example 만 예외).
#    실제 시크릿을 이 파일에 적지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 애플리케이션 ─────────────────────────────────────────────
# 업무일자(business_date) 파생 기준. 변경하지 마세요.
APP_TIMEZONE="Asia/Seoul"

# ─────────────────────────────────────────────────────────────
# 아래 항목은 해당 작업에서 도입됩니다. T0-1 에서는 사용하지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 (T0-2) ──────────────────────────────────────
# DATABASE_URL : 런타임용. Supabase Supavisor(transaction mode) 경유.
#                서버리스 커넥션 폭증 방지를 위해 반드시 pooler 를 사용합니다.
# DIRECT_URL   : prisma migrate / 워커 전용 직결 커넥션.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── 인증 (T0-6) ──────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── 파일 저장 (T4-2, R1a-4) ──────────────────────────────────
# SUPABASE_STORAGE_BUCKET_IMPORTS="imports"
# SUPABASE_STORAGE_BUCKET_EVIDENCE="evidence"
# SUPABASE_STORAGE_BUCKET_EXPORTS="exports"

# ── 비동기 잡 큐 (T4-1, R1a-4) ───────────────────────────────
# PGBOSS_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# PGBOSS_SCHEMA="pgboss"
