# FIN-01 실제 호출(--live) 용 환경변수 예시.
# 실제 값은 이 저장소에 넣지 말고 서버 비밀 저장소 또는 로컬 .env.fin01(.gitignore 대상)에 둔다.
#   cp fin/FIN-01/fin01.env.example .env.fin01 && set -a && . ./.env.fin01 && set +a
# 비밀번호·토큰을 대화나 이슈에 붙여 넣지 않는다.

# 환율 — 한국수출입은행 Open API (https://www.koreaexim.go.kr/ir/HPHKIR020M01 에서 인증키 발급)
FIN01_KOREAEXIM_AUTHKEY=
# 환율 — 한국은행 ECOS (https://ecos.bok.or.kr/api/ 에서 인증키 발급)
FIN01_ECOS_API_KEY=

# 은행 — 금융결제원 오픈뱅킹 (이용기관 등록·계좌등록 후 발급되는 Access Token 과 핀테크이용번호)
FIN01_KFTC_BASE_URL=https://testapi.openbanking.or.kr
FIN01_KFTC_ACCESS_TOKEN=
FIN01_KFTC_FINTECH_USE_NUM=

# 광고 — 메타 (System User 토큰, 광고 계정 ID 는 act_ 접두사 포함)
FIN01_META_ACCESS_TOKEN=
FIN01_META_AD_ACCOUNT_ID=act_

# 광고 — 틱톡 Marketing API
FIN01_TIKTOK_ACCESS_TOKEN=
FIN01_TIKTOK_ADVERTISER_ID=

# 광고 — 네이버 검색광고 (광고플랫폼 > 도구 > API 사용관리)
FIN01_NAVER_API_KEY=
FIN01_NAVER_SECRET_KEY=
FIN01_NAVER_CUSTOMER_ID=

# 자사몰 — 카페24 Admin API (OAuth Access Token, 2시간 유효)
FIN01_CAFE24_MALL_ID=
FIN01_CAFE24_ACCESS_TOKEN=
