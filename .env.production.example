# ─────────────────────────────────────────────────────────────
# DEEPPOINT SCM OS — PRODUCTION 환경 키 목록 (예시 파일)
#
# ⚠️ 이 파일은 "어떤 키가 필요한가"의 정의다. **실제 값을 채워 커밋하지 않는다.**
#    production 값은 호스팅(예: Vercel 프로젝트의 Production 환경변수)에서만
#    주입한다. 저장소와 CI 에는 production 자격증명이 존재하지 않는다.
#    CI·테스트는 Testcontainers 가 만든 일회용 DB 만 사용한다.
# ─────────────────────────────────────────────────────────────

# 환경 식별자 (NODE_ENV=production 빌드에서만 허용)
APP_ENV="production"

# 업무일자 기준 (전 환경 공통 고정값)
APP_TIMEZONE="Asia/Seoul"

# 데이터베이스 — 운영 Supabase 프로젝트
#   DATABASE_URL: Supavisor pooler(6543, pgbouncer=true&connection_limit=1)
#   DIRECT_URL  : 직결(5432) — migrate 전용
DATABASE_URL=""
DIRECT_URL=""

# 인증 — 운영 Supabase 프로젝트의 URL·publishable key
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ⛔ 설정 금지: ENABLE_ERROR_PREVIEW (개발 전용 — 운영에서 켜지지 않는다)
# ⛔ 설정 금지: DB_TEST_SERVER_URL (테스트 하네스 전용)
