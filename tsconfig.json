{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,

    /* ── strict 설정 ─────────────────────────────────────────────
     * 재고 도메인은 수량·금액 계산이 핵심이므로 타입 안전성을 최대로 올린다.
     * 특히 noUncheckedIndexedAccess 는 배열 인덱싱 결과를 undefined 로 취급해
     * 원장 entry / BOM 라인 접근 시 누락을 컴파일 타임에 잡는다.
     */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "verbatimModuleSyntax": true,

    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  /* ── 제외 ───────────────────────────────────────────────────
   * inventory-boundary fixture 는 ESLint 규칙(import 경로·이름 기반) 검증 전용이며,
   * 아직 존재하지 않는 Prisma 모델과 모듈 경로를 의도적으로 참조한다.
   * 타입 검사 대상이 아니다. 규칙 검증은
   * tests/eslint-rules/inventory-boundary.test.ts 가 담당한다.
   */
  "exclude": [
    "node_modules",
    "eslint-rules/__fixtures__/inventory-boundary/**",
    /* fin/fin02a 는 NestJS 데코레이터 옵션이 필요한 독립 패키지다. 루트 검사에서 제외하는 대신
     * 자체 tsconfig·eslint·prettier·vitest 로 CI(.github/workflows/ci.yml 의 fin02a 잡)에서 별도 검사한다.
     * fin/FIN-01/** 은 계속 루트 검사 대상이다. */
    "fin/fin02a/**"
  ]
}
