# ─────────────────────────────────────────────────────────────
# DEEPPOINT SCM OS — STAGING 환경 키 목록 (예시 파일)
#
# ⚠️ 이 파일은 "어떤 키가 필요한가"의 정의다. **실제 값을 채워 커밋하지 않는다.**
#    staging 값은 호스팅(예: Vercel 프로젝트의 Staging 환경변수)에서만 주입한다.
#    저장소와 CI 에는 staging 자격증명이 존재하지 않는다.
# ─────────────────────────────────────────────────────────────

# 환경 식별자 — staging 은 기본값이 될 수 없으므로 반드시 명시한다.
# (NODE_ENV=production 빌드에서만 허용 — src/shared/env.ts loadAppEnv)
APP_ENV="staging"

# 업무일자 기준 (전 환경 공통 고정값)
APP_TIMEZONE="Asia/Seoul"

# 데이터베이스 — staging 전용 Supabase 프로젝트 (운영과 다른 프로젝트)
#   DATABASE_URL: Supavisor pooler(6543) / DIRECT_URL: 직결(5432)
DATABASE_URL=""
DIRECT_URL=""

# 인증 — staging 전용 Supabase 프로젝트의 URL·publishable key
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ⛔ 설정 금지: ENABLE_ERROR_PREVIEW (개발 전용)
# ⛔ 설정 금지: DB_TEST_SERVER_URL (테스트 하네스 전용)
